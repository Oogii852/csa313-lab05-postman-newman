{
  "info": {
    "name": "Lab05 Registration API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "T01 Happy path: идэвхтэй оюутан, урьдач хангасан → 201 OK",
      "item": [
        {
          "name": "Setup: PUT /students/T01_STU",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup OK: PUT /students/T01_STU\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/students/T01_STU",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "T01_STU"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"active\",\"coursesTaken\":[\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Setup: PUT /courses/T01_CRS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup OK: PUT /courses/T01_CRS\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses/T01_CRS",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "T01_CRS"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\":[\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "POST /registrations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус код 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"result = OK\", () => pm.expect(pm.response.json().result).to.eql(\"OK\"));",
                  "pm.test(\"registrationID нь тоо\", () => pm.expect(pm.response.json().registrationID).to.be.a(\"number\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"T01_STU\",\"courseID\":\"T01_CRS\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
