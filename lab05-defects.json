{
  "info": {
    "name": "Lab05 Registration API (DEFECTS)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "D1 Давхар бүртгэл: нэг оюутан нэг хичээлд 2 удаа бүртгүүлж болохгүй",
      "item": [
        {
          "name": "Setup: PUT /students/D1_STU",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup OK: PUT /students/D1_STU\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/students/D1_STU",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "D1_STU"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"active\",\"coursesTaken\":[]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Setup: PUT /courses/D1_CRS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup OK: PUT /courses/D1_CRS\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses/D1_CRS",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "D1_CRS"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\":[]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "1-р бүртгэл",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"1-р бүртгэл 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"D1_STU\",\"courseID\":\"D1_CRS\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2-р бүртгэл (яг ижил)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"2-р бүртгэл 201 БИШ байх ёстой\", () => pm.expect(pm.response.code).to.not.equal(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"D1_STU\",\"courseID\":\"D1_CRS\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
